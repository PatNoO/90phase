<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Dark parent: the app is dark-only by design (CLAUDE.md § Design System), so the raw
         Activity window must never default to a light background before Compose paints. -->
    <style name="Theme._90phase" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_sky_navy_blue</item>
        <item name="android:statusBarColor">@color/night_sky_navy_blue</item>
        <item name="android:navigationBarColor">@color/night_sky_navy_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- android:windowLightNavigationBar requires API 27; minSdk is 26, so it's a no-op
             (safely ignored) on API 26 devices rather than unavailable. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="Theme._90phase.Transparent" parent="Theme._90phase">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
