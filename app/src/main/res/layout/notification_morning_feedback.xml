<?xml version="1.0" encoding="utf-8"?><!--
     Expanded morning-rating view: the collapsed content plus a body line and the secondary
     actions.

     Colours come from theme attributes rather than fixed values, so the text stays legible on
     both light and dark notification shades. The previous layout hardcoded #888888 for the
     "turn off" line and left the body with no colour at all, which risked invisible text on
     OEM skins that restyle the shade.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/notification_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/notification_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/notification_gap_tiny"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:textColor="?android:attr/textColorSecondary" />

    <include layout="@layout/notification_morning_feedback_stars" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_skip"
            style="@style/MorningRatingAction"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_turn_off"
            style="@style/MorningRatingAction"
            android:layout_weight="1"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

</LinearLayout>
