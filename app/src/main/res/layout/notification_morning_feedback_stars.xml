<?xml version="1.0" encoding="utf-8"?><!--
     The five rating targets, shared by the collapsed and expanded layouts so the two can never
     drift apart.

     Each star is 48dp square — the accessibility minimum. The previous layout used 40dp buttons
     crammed six-to-a-row, which was both below the minimum and easy to mis-tap.

     ★ matches the StarRating composable used inside the app, so the notification and the History
     screen speak the same visual language. Content descriptions are set in code, where the
     rating value is known.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/btn_star_1"
        style="@style/MorningRatingStar" />

    <TextView
        android:id="@+id/btn_star_2"
        style="@style/MorningRatingStar" />

    <TextView
        android:id="@+id/btn_star_3"
        style="@style/MorningRatingStar" />

    <TextView
        android:id="@+id/btn_star_4"
        style="@style/MorningRatingStar" />

    <TextView
        android:id="@+id/btn_star_5"
        style="@style/MorningRatingStar" />

</LinearLayout>
