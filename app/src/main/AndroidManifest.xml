<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for AlarmManager.setExactAndAllowWhileIdle() on Android 12+ -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Required for Android 13+ to post notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required to reschedule alarms after device restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".NinetyPhaseApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme._90phase">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme._90phase">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notifications.DailyCheckInReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.DisableCheckInReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.BedtimeReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.MorningFeedbackReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.RatingActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.SkipMorningFeedbackReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.DisableMorningFeedbackReceiver"
            android:exported="false" />

        <activity
            android:name=".MorningBedtimeLogActivity"
            android:exported="false"
            android:theme="@style/Theme._90phase.Transparent" />

        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>