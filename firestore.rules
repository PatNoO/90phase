rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny — nothing is readable or writable unless explicitly allowed below
    match /{document=**} {
      allow read, write: if false;
    }

    // Authenticated users may only read and write their own user document and sub-collections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
